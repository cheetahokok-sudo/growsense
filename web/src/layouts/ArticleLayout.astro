---
// Shared article shell for every Evidence Library page. This ONE file is the
// design system — change it once, rebuild, and all articles update. It also
// adds the Open Graph / Twitter share-card tags the hand-built pages lack.
const { data } = Astro.props;
const blogBase = 'https://www.growsense.life/blog/';
const ogImage = new URL(data.hero, blogBase).href;
const canonical = new URL(Astro.url.pathname.replace(/^\/blog\//, ''), blogBase).href;
---
<!doctype html>
<html lang={data.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{data.title}</title>
  <meta name="description" content={data.description} />
  <link rel="canonical" href={canonical} />
  <!-- Open Graph (Facebook / LINE / general link previews) -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="GrowSense" />
  <meta property="og:title" content={data.title} />
  <meta property="og:description" content={data.description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={data.title} />
  <meta name="twitter:description" content={data.description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root{
      --deep:#0E2A20; --accent:#2F6B4F; --accent-dark:#1B4632;
      --ink:#1a2420; --text2:#43504a; --muted:#8a938c;
      --line:#e6eae7; --bg:#ffffff; --tint:#f4f8f6; --gold:#9C7A3D; --gold-tint:#f6efe0;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);
      font-family:'Inter',system-ui,'Sarabun',sans-serif;font-size:18px;line-height:1.75;-webkit-font-smoothing:antialiased}
    .gs-topbar{background:var(--deep);color:#fff;padding:12px 22px;display:flex;align-items:center;gap:9px}
    .gs-topbar .mark{width:26px;height:26px;border-radius:7px;background:var(--accent);display:flex;align-items:center;justify-content:center}
    .gs-topbar a{color:#fff;text-decoration:none;font-weight:700;font-size:16px}
    .gs-topbar .hub{margin-left:auto;color:rgba(255,255,255,.82);text-decoration:none;font-size:13.5px;font-weight:600;white-space:nowrap}
    .gs-topbar .hub:hover{color:#fff}
    article{max-width:720px;margin:0 auto;padding:28px 22px 20px}
    .hero{margin:0 0 26px;border-radius:14px;overflow:hidden;background:var(--deep);aspect-ratio:16/9}
    .hero img{display:block;width:100%;height:100%;object-fit:cover}
    .eyebrow{color:var(--accent);font-weight:600;font-size:13px;letter-spacing:.05em;text-transform:uppercase;margin:0 0 10px}
    h1{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:38px;line-height:1.12;margin:0 0 14px;color:var(--deep)}
    .byline{font-size:14px;color:var(--muted);margin:0 0 6px}
    .review{display:inline-block;font-size:12.5px;background:var(--tint);border:1px solid var(--line);border-radius:20px;padding:3px 11px;color:var(--accent-dark);font-weight:600;margin-bottom:26px}
    h2{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:25px;line-height:1.2;margin:38px 0 12px;color:var(--deep);scroll-margin-top:70px}
    p{margin:0 0 18px;color:var(--text2)}
    strong{color:var(--ink);font-weight:600}
    em{color:var(--ink)}
    a{color:var(--accent)}
    .lede{font-size:20px;color:var(--ink)}
    table{width:100%;border-collapse:collapse;margin:8px 0 20px;font-size:15.5px}
    th,td{padding:9px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
    th{background:var(--tint);color:var(--deep);font-weight:600;font-size:13px}
    .flow{background:var(--deep);color:#eaf3ed;border-radius:12px;padding:16px 18px;margin:10px 0 20px;font-size:16px;line-height:1.7}
    .flow b{color:#8fd3ae;font-weight:600}
    .callout{background:var(--gold-tint);border-left:3px solid var(--gold);border-radius:0 8px 8px 0;padding:12px 16px;margin:18px 0;font-size:16px;color:#5c4a25}
    .callout strong{color:#4a3a1c}
    .formula{background:var(--tint);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:8px 0 18px;font-size:16px}
    ul{padding-left:22px}
    li{margin:7px 0;color:var(--text2)}
    .cta{background:var(--tint);border:1px solid var(--line);border-radius:12px;padding:20px;margin:32px 0}
    .cta h2{margin-top:0}
    .cta a{display:inline-block;margin-top:8px;background:var(--accent);color:#fff;text-decoration:none;font-weight:600;padding:10px 20px;border-radius:8px;font-size:15px}
    /* GFM footnotes → styled as the References block */
    .footnotes{margin-top:40px;border-top:1px solid var(--line);padding-top:16px;font-size:14px;line-height:1.6;color:var(--text2)}
    .footnotes h2, .footnotes::before{}
    .footnotes ol{padding-left:22px}
    .footnotes li{margin:8px 0;color:var(--text2)}
    sup a, .footnotes a{color:var(--accent);text-decoration:none;font-weight:600}
    .refs-heading{margin-top:40px;font-size:18px;font-family:'Inter',sans-serif;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
    .backhub{margin:34px 0 6px}
    .backhub a{display:inline-flex;align-items:center;gap:7px;background:var(--tint);border:1px solid var(--line);color:var(--accent-dark);text-decoration:none;font-weight:600;font-size:15px;padding:11px 18px;border-radius:9px}
    .backhub a:hover{border-color:var(--accent)}
    .disclaimer{font-size:13.5px;color:var(--muted);line-height:1.6;margin-top:24px;border-top:1px solid var(--line);padding-top:16px}
    footer{background:var(--deep);color:rgba(255,255,255,.55);text-align:center;font-size:13px;padding:28px 22px;margin-top:36px}
    footer a{color:rgba(255,255,255,.8);text-decoration:none;margin:0 8px}
    @media(max-width:560px){body{font-size:17px}h1{font-size:29px}h2{font-size:22px}table{font-size:14.5px}th,td{padding:8px 9px}}
  </style>
</head>
<body>
  <nav class="gs-topbar">
    <span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M3 17l5-5 4 4 8-9"/><circle cx="20" cy="7" r="1.4" fill="#fff" stroke="none"/></svg></span>
    <a href="https://www.growsense.life">GrowSense</a>
    <a class="hub" href="https://www.growsense.life/blog/">Growth science</a>
  </nav>

  <article>
    <figure class="hero">
      <img src={data.hero} alt={data.heroAlt} loading="eager" onerror="this.closest('.hero').style.display='none'" />
    </figure>
    <p class="eyebrow">{data.eyebrow}</p>
    <h1>{data.h1}</h1>
    <p class="byline">GrowSense Growth Science · Educational, not medical advice</p>
    <div class="review">Every claim sourced to peer-reviewed research — see references below</div>

    <slot />

    <div class="backhub"><a href="https://www.growsense.life/blog/">← All Growth Science articles</a></div>
    <p class="disclaimer">{data.disclaimer}</p>
  </article>

  <footer>
    © 2026 GrowSense · Pediatric growth intelligence
    <div><a href="https://www.growsense.life">Home</a>·<a href="https://www.growsense.life/privacy">Privacy</a>·<a href="https://www.growsense.life/support">Support</a></div>
  </footer>
</body>
</html>
