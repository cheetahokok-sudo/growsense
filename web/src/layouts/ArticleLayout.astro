---
// Shared article shell for every Evidence Library page. This ONE file is the
// design system — change it once, rebuild, and all articles update. It renders
// the References block from frontmatter (grouped, continuous r1..rN ids) and
// adds the Open Graph / Twitter share tags + hreflang the hand-built pages lack.
import { execFileSync } from 'node:child_process';
import { readFileSync } from 'node:fs';

const { data, id } = Astro.props;
const srcFile = id ? `src/content/articles/${id}` : null;

// Publication dates come from git rather than a frontmatter field, so they
// cannot drift or be wrong: the first commit that added the file IS the
// publication date, and the last commit that touched it IS the modification
// date. Nothing to remember to update, and nothing to invent.
function gitDate(file, first) {
  if (!file) return null;
  try {
    const args = first
      ? ['log', '--diff-filter=A', '--follow', '--format=%cI', '--', file]
      : ['log', '-1', '--format=%cI', '--', file];
    const out = execFileSync('git', args, { encoding: 'utf8' }).trim();
    const lines = out.split('\n').filter(Boolean);
    return (first ? lines[lines.length - 1] : lines[0]) || null;
  } catch {
    return null; // not a git checkout (e.g. a clean CI clone) — omit rather than fake
  }
}
const datePublished = gitDate(srcFile, true);
const dateModified = gitDate(srcFile, false) ?? datePublished;

// Pull the Q&A pairs out of the article's own <div class="faq"> block so the
// FAQPage schema can never disagree with what's on the page — it is generated
// FROM the page. Skipped silently for articles with no FAQ.
function extractFaq(file) {
  if (!file) return [];
  let raw;
  try {
    raw = readFileSync(file, 'utf8');
  } catch {
    return [];
  }
  const block = raw.match(/<div class="faq">([\s\S]*?)<\/div>/)?.[1];
  if (!block) return [];
  const text = (s) =>
    s
      .replace(/<sup>[\s\S]*?<\/sup>/g, '') // drop "[1]" citation markers — meaningless out of context
      .replace(/<[^>]+>/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  const out = [];
  const re = /<p class="q">([\s\S]*?)<\/p>([\s\S]*?)(?=<p class="q">|$)/g;
  let m;
  while ((m = re.exec(block))) {
    const q = text(m[1]);
    const a = text(m[2]);
    if (q && a) out.push({ q, a });
  }
  return out;
}
const faqs = extractFaq(srcFile);

const blogBase = 'https://www.growsense.life/blog/';
const ogImage = new URL(data.hero, blogBase).href;
const canonical = new URL(Astro.url.pathname.replace(/^\/blog\//, ''), blogBase).href;

// Localized chrome + toggle labels (article body/refs come from frontmatter).
const selfLabels = { en: 'EN', th: 'ไทย', zh: '中文' };
const selfLabel = selfLabels[data.lang] ?? data.lang.toUpperCase();
const UI = {
  en: { byline: 'Educational, not medical advice', review: 'Every claim sourced to peer-reviewed research — see references below', hub: 'Growth science', back: '← All Growth Science articles', refs: 'References' },
  th: { byline: 'เพื่อให้ความรู้ ไม่ใช่คำแนะนำทางการแพทย์', review: 'ทุกข้อมูลอ้างอิงจากงานวิจัยที่ผ่านการตรวจสอบ — ดูแหล่งอ้างอิงด้านล่าง', hub: 'บทความทั้งหมด', back: '← ดูบทความทั้งหมด', refs: 'แหล่งอ้างอิง' },
  zh: { byline: '仅供科普参考，非医疗建议', review: '每一条论述均引自同行评审研究 — 详见文末参考文献', hub: '成长科学', back: '← 查看全部文章', refs: '参考文献' },
};
const ui = UI[data.lang] ?? UI.en;
// x-default → the English version (self if this is EN, else the 'en' alt).
const allLangs = [{ code: data.lang, href: canonical }, ...(data.langAlts ?? [])];
const enHref = (allLangs.find((l) => l.code === 'en') ?? allLangs[0]).href;
const hasAlts = (data.langAlts ?? []).length > 0;
const locales = { en: 'en_US', th: 'th_TH', zh: 'zh_CN' };
const selfLocale = locales[data.lang] ?? 'en_US';
const altLocales = (data.langAlts ?? []).map((a) => locales[a.code]).filter(Boolean);

// Turn "PMID: 12345678" into a real link to the paper. The citations are the
// strongest trust signal these pages have; as plain text they are invisible to
// a crawler and unusable to a parent who wants to check us. Deliberately NOT
// rel="nofollow" — an outbound link to PubMed is a signal we want to send.
const linkPmids = (html) =>
  html.replace(
    /PMID:\s*(\d{4,9})/g,
    '<a href="https://pubmed.ncbi.nlm.nih.gov/$1/" target="_blank" rel="noopener">PMID: $1</a>',
  );

// Flatten references into continuously-numbered groups (ids stay stable).
let counter = 0;
const refGroups = (data.references ?? []).map((g) => {
  const items = g.items.map((text) => ({ n: ++counter, text: linkPmids(text) }));
  return { group: g.group, items, start: items.length ? items[0].n : 1 };
});

// ── JSON-LD ────────────────────────────────────────────────────────────────
// MedicalWebPage tells Google this is health content and hands it the citation
// list explicitly, rather than hoping it infers both from the prose.
//
// HONESTY CONSTRAINTS — do not "improve" these without them becoming true:
//   • author/publisher is the GrowSense organisation. No named person claims
//     authorship of pages a person did not write.
//   • there is NO reviewedBy / MedicalAudience reviewer. Nobody clinically
//     reviews these articles today. Claiming a reviewer to win E-E-A-T would
//     be a lie to parents making decisions about a child.
const stripTags = (s) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const citations = (data.references ?? [])
  .flatMap((g) => g.items)
  .map((raw) => {
    const pmid = raw.match(/PMID:\s*(\d{4,9})/)?.[1];
    if (!pmid) return null;
    return {
      '@type': 'ScholarlyArticle',
      name: stripTags(raw).replace(/\s*PMID:\s*\d+\.?\s*$/, ''),
      identifier: `PMID:${pmid}`,
      url: `https://pubmed.ncbi.nlm.nih.gov/${pmid}/`,
    };
  })
  .filter(Boolean);

const org = {
  '@type': 'Organization',
  name: 'GrowSense',
  url: 'https://www.growsense.life',
};
const medicalPage = {
  '@type': 'MedicalWebPage',
  '@id': `${canonical}#page`,
  headline: data.h1,
  name: data.title,
  description: data.description,
  image: ogImage,
  url: canonical,
  inLanguage: data.lang,
  isAccessibleForFree: true,
  author: org,
  publisher: org,
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
  ...(citations.length ? { citation: citations } : {}),
};

// FAQPage is emitted only when the page actually has a visible FAQ — Google
// requires the marked-up Q&A to be present on the page, and marking up
// questions a reader can't see is exactly the kind of thing that earns a
// structured-data manual action.
const faqPage = faqs.length
  ? {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      inLanguage: data.lang,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': faqPage ? [medicalPage, faqPage] : [medicalPage],
};
---
<!doctype html>
<html lang={data.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{data.title}</title>
  <meta name="description" content={data.description} />
  <link rel="canonical" href={canonical} />
  <!-- Icons live at the site root, not under /blog/ — absolute paths. -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {hasAlts && (
    <Fragment>
      <link rel="alternate" hreflang={data.lang} href={canonical} />
      {data.langAlts.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
      <link rel="alternate" hreflang="x-default" href={enHref} />
    </Fragment>
  )}
  <!-- Structured data: declares this as medical content and hands Google the
       citation list explicitly. Built from frontmatter — see jsonLd above. -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- Open Graph (Facebook / LINE / general link previews) -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="GrowSense" />
  <meta property="og:title" content={data.title} />
  <meta property="og:description" content={data.description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={selfLocale} />
  {altLocales.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={data.title} />
  <meta name="twitter:description" content={data.description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root{
      --deep:#0E2A20; --accent:#2F6B4F; --accent-dark:#1B4632;
      --ink:#1a2420; --text2:#43504a; --muted:#8a938c;
      --line:#e6eae7; --bg:#ffffff; --tint:#f4f8f6; --gold:#9C7A3D; --gold-tint:#f6efe0;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);
      font-family:'Inter',system-ui,'Sarabun',sans-serif;font-size:18px;line-height:1.75;-webkit-font-smoothing:antialiased}
    .gs-topbar{background:var(--deep);color:#fff;padding:12px 22px;display:flex;align-items:center;gap:9px}
    .gs-topbar .mark{width:26px;height:26px;border-radius:7px;background:var(--accent);display:flex;align-items:center;justify-content:center}
    .gs-topbar a{color:#fff;text-decoration:none;font-weight:700;font-size:16px}
    .gs-topbar .hub{margin-left:auto;color:rgba(255,255,255,.82);text-decoration:none;font-size:13.5px;font-weight:600;white-space:nowrap}
    .gs-topbar .hub:hover{color:#fff}
    .gs-topbar .lang{margin-left:0;display:flex;gap:4px}
    .gs-topbar .lang a{color:rgba(255,255,255,.65);font-size:13px;font-weight:600;padding:3px 9px;border-radius:20px}
    .gs-topbar .lang a.on{background:var(--accent);color:#fff}
    article{max-width:720px;margin:0 auto;padding:28px 22px 20px}
    .hero{margin:0 0 26px;border-radius:14px;overflow:hidden;background:var(--deep);aspect-ratio:16/9}
    .hero img{display:block;width:100%;height:100%;object-fit:cover}
    /* In-body figure. The hero is decorative; a figure earns its place by
       teaching something the prose can't — so the caption is mandatory and
       does the explaining (the image itself carries no baked-in labels). */
    figure{margin:22px 0}
    figure img{display:block;width:100%;height:auto;border-radius:12px}
    figcaption{margin-top:8px;font-size:12.5px;line-height:1.5;color:var(--muted)}
    figcaption b{color:var(--ink)}
    .eyebrow{color:var(--accent);font-weight:600;font-size:13px;letter-spacing:.05em;text-transform:uppercase;margin:0 0 10px}
    h1{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:38px;line-height:1.12;margin:0 0 14px;color:var(--deep)}
    .byline{font-size:14px;color:var(--muted);margin:0 0 6px}
    .review{display:inline-block;font-size:12.5px;background:var(--tint);border:1px solid var(--line);border-radius:20px;padding:3px 11px;color:var(--accent-dark);font-weight:600;margin-bottom:26px}
    h2{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:25px;line-height:1.2;margin:38px 0 12px;color:var(--deep);scroll-margin-top:70px}
    p{margin:0 0 18px;color:var(--text2)}
    strong{color:var(--ink);font-weight:600}
    em{color:var(--ink)}
    a{color:var(--accent)}
    sup a{font-size:12px;text-decoration:none;font-weight:600;padding:0 1px}
    .lede{font-size:20px;color:var(--ink)}
    table{width:100%;border-collapse:collapse;margin:8px 0 20px;font-size:15.5px}
    th,td{padding:9px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
    th{background:var(--tint);color:var(--deep);font-weight:600;font-size:13px}
    .flow{background:var(--deep);color:#eaf3ed;border-radius:12px;padding:16px 18px;margin:10px 0 20px;font-size:16px;line-height:1.7}
    .flow b{color:#8fd3ae;font-weight:600}
    .callout{background:var(--gold-tint);border-left:3px solid var(--gold);border-radius:0 8px 8px 0;padding:12px 16px;margin:18px 0;font-size:16px;color:#5c4a25}
    .callout strong{color:#4a3a1c}
    .formula{background:var(--tint);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:8px 0 18px;font-size:16px}
    .primer{background:var(--tint);border:1px solid var(--line);border-radius:12px;padding:6px 20px 14px;margin:18px 0}
    .scen{background:var(--tint);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:8px 0 16px;font-size:16px}
    .scen b{color:var(--deep)}
    .faq p{margin:0 0 4px}
    .faq .q{color:var(--ink);font-weight:600;margin-top:16px}
    ul,ol.steps{padding-left:22px}
    li{margin:7px 0;color:var(--text2)}
    .cta{background:var(--tint);border:1px solid var(--line);border-radius:12px;padding:20px;margin:32px 0}
    .cta h2{margin-top:0}
    .cta a{display:inline-block;margin-top:8px;background:var(--accent);color:#fff;text-decoration:none;font-weight:600;padding:10px 20px;border-radius:8px;font-size:15px}
    .refs{margin-top:40px;border-top:1px solid var(--line);padding-top:20px}
    .refs h2{font-size:18px;font-family:'Inter',sans-serif;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
    .refgroup{font-size:12px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--accent);margin:14px 0 4px}
    .refs ol{padding-left:22px;font-size:14px;line-height:1.6;color:var(--text2)}
    .refs li{margin:8px 0}
    .backhub{margin:34px 0 6px}
    .backhub a{display:inline-flex;align-items:center;gap:7px;background:var(--tint);border:1px solid var(--line);color:var(--accent-dark);text-decoration:none;font-weight:600;font-size:15px;padding:11px 18px;border-radius:9px}
    .backhub a:hover{border-color:var(--accent)}
    .disclaimer{font-size:13.5px;color:var(--muted);line-height:1.6;margin-top:24px;border-top:1px solid var(--line);padding-top:16px}
    footer{background:var(--deep);color:rgba(255,255,255,.55);text-align:center;font-size:13px;padding:28px 22px;margin-top:36px}
    footer a{color:rgba(255,255,255,.8);text-decoration:none;margin:0 8px}
    @media(max-width:560px){body{font-size:17px}h1{font-size:29px}h2{font-size:22px}table{font-size:14.5px}th,td{padding:8px 9px}}
  </style>
</head>
<body>
  <nav class="gs-topbar">
    <span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M3 17l5-5 4 4 8-9"/><circle cx="20" cy="7" r="1.4" fill="#fff" stroke="none"/></svg></span>
    <a href="https://www.growsense.life">GrowSense</a>
    <a class="hub" href="https://www.growsense.life/blog/">{ui.hub}</a>
    {hasAlts && (
      <span class="lang">
        <a class="on" href={canonical}>{selfLabel}</a>
        {data.langAlts.map((alt) => <a href={alt.href}>{alt.label}</a>)}
      </span>
    )}
  </nav>

  <article>
    <figure class="hero">
      <img src={data.hero} alt={data.heroAlt} loading="eager" onerror="this.closest('.hero').style.display='none'" />
    </figure>
    <p class="eyebrow">{data.eyebrow}</p>
    <h1>{data.h1}</h1>
    <p class="byline">GrowSense Growth Science · {ui.byline}</p>
    <div class="review">{ui.review}</div>

    <slot />

    {refGroups.length > 0 && (
      <div class="refs">
        <h2>{ui.refs}</h2>
        {refGroups.map((g) => (
          <Fragment>
            {g.group && <p class="refgroup">{g.group}</p>}
            <ol start={g.start}>
              {g.items.map((it) => <li id={`r${it.n}`} set:html={it.text} />)}
            </ol>
          </Fragment>
        ))}
      </div>
    )}

    <div class="backhub"><a href="https://www.growsense.life/blog/">{ui.back}</a></div>
    <p class="disclaimer">{data.disclaimer}</p>
  </article>

  <footer>
    © 2026 GrowSense · Pediatric growth intelligence
    <div><a href="https://www.growsense.life">Home</a>·<a href="https://www.growsense.life/privacy">Privacy</a>·<a href="https://www.growsense.life/support">Support</a></div>
  </footer>
</body>
</html>
